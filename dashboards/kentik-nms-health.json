        "current": {},
        "hide": 0
      },
      {
        "name": "device",
        "type": "query",
        "label": "Device",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/metrics/system, device_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
