{
  "uid": "kentik-nms-health",
  "title": "Kentik: NMS Device Health",
  "tags": [
    "kentik",
    "nms"
  ],
  "timezone": "",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
