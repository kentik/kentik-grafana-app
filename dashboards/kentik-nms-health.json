    {
      "id": 1,
      "type": "stat",
      "title": "Devices Reporting",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/.*/",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/metrics/system",
          "metrics": [
            "rtt-avg"
          ],
          "dimensions": [
            "device_name"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 3,
          "limit": 500,
          "format": "table",
          "rollups": [
            {
              "metric": "rtt-avg",
              "fn": "avg"
            }
          ]
        }
      ]
    },
