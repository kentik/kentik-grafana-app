{
  "uid": "kentik-site-overview",
  "title": "Kentik: Sites & Devices",
  "tags": [
    "kentik"
  ],
  "timezone": "",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "label": "Kentik datasource",
        "query": "kentik-connect-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_site_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "device",
        "type": "query",
        "label": "Device",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "metric",
        "type": "custom",
        "label": "Metric",
        "query": "both_bits_per_sec,both_pkts_per_sec,total_bytes",
        "current": {
          "text": "both_bits_per_sec",
          "value": "both_bits_per_sec"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic by Site \u2014 $metric",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "$metric"
          ],
          "dimensions": [
            "i_device_site_name"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 1,
          "limit": 15,
          "aliasBy": "{{i_device_site_name}}",
          "rollups": [
            {
              "metric": "$metric",
              "fn": "avg"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Traffic by Device \u2014 $metric",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "$metric"
          ],
          "dimensions": [
            "i_device_name"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 3,
          "limit": 10,
          "aliasBy": "{{i_device_name}}",
          "rollups": [
            {
              "metric": "$metric",
              "fn": "avg"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingress vs Egress by Site",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "in_bits_per_sec",
            "out_bits_per_sec"
          ],
          "dimensions": [
            "i_device_site_name"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 1,
          "limit": 10,
          "aliasBy": "{{i_device_site_name}}",
          "rollups": [
            {
              "metric": "in_bits_per_sec",
              "fn": "avg"
            },
            {
              "metric": "out_bits_per_sec",
              "fn": "avg"
            }
          ]
        }
      ]
    }
  ]
}