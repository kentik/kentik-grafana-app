{
  "uid": "kentik-osi-health",
  "title": "Kentik: Traffic Detail",
  "tags": [
    "kentik"
  ],
  "timezone": "",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "label": "Kentik datasource",
        "query": "kentik-connect-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_site_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "device",
        "type": "query",
        "label": "Device",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingress",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1000000000,
                "color": "yellow"
              },
              {
                "value": 10000000000,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "in_bits_per_sec"
          ],
          "dimensions": [],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 3,
          "limit": 1,
          "rollups": [
            {
              "metric": "in_bits_per_sec",
              "fn": "avg"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
