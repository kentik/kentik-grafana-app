{
  "uid": "kentik-top-talkers",
  "title": "Kentik: Top Talkers",
  "tags": [
    "kentik"
  ],
  "timezone": "",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "label": "Kentik datasource",
        "query": "kentik-connect-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "breakout",
        "type": "query",
        "label": "Break out by (dictionary)",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "dimensions(/traffic)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "current": {
          "text": "inet_src_addr",
          "value": "inet_src_addr"
        },
        "hide": 0
      },
      {
        "name": "metric",
        "type": "custom",
        "label": "Metric",
        "query": "both_bits_per_sec,both_pkts_per_sec,total_bytes",
        "current": {
          "text": "both_bits_per_sec",
          "value": "both_bits_per_sec"
        },
        "hide": 0
      },
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_site_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "device",
        "type": "query",
        "label": "Device",
        "datasource": {
          "type": "kentik-connect-datasource",
          "uid": "${ds}"
        },
        "query": "values(/traffic, i_device_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "__ALL__",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Top by $breakout \u2014 $metric",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "$metric"
          ],
          "dimensions": [
            "$breakout"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 1,
          "limit": 10,
          "aliasBy": "{{$breakout}}",
          "rollups": [
            {
              "metric": "$metric",
              "fn": "avg"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Top Source IPs",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "$metric"
          ],
          "dimensions": [
            "inet_src_addr"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 3,
          "limit": 10,
          "aliasBy": "{{inet_src_addr}}",
          "rollups": [
            {
              "metric": "$metric",
              "fn": "avg"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Top Destination Ports",
      "datasource": {
        "type": "kentik-connect-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "kentik-connect-datasource",
            "uid": "${ds}"
          },
          "queryType": "ude",
          "measurement": "/traffic",
          "metrics": [
            "$metric"
          ],
          "dimensions": [
            "l4_dst_port"
          ],
          "filterGroups": [
            {
              "connector": "All",
              "not": false,
              "filters": [
                {
                  "filter_field": "i_device_site_name",
                  "operator": "=",
                  "filter_value": "$site"
                },
                {
                  "filter_field": "i_device_name",
                  "operator": "=",
                  "filter_value": "$device"
                }
              ]
            }
          ],
          "filterConnector": "All",
          "vizType": 3,
          "limit": 10,
          "aliasBy": "port {{l4_dst_port}}",
          "rollups": [
            {
              "metric": "$metric",
              "fn": "avg"
            }
          ]
        }
      ]
    }
  ]
}