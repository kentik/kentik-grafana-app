{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Kentik",
  "id": "kentik-connect-datasource",
  "metrics": true,
  "backend": true,
  "alerting": true,
  "executable": "gpx_kentik-connect-datasource",
  "info": {
    "description": "Visualize and explore Kentik network observability data in Grafana.",
    "author": {
      "name": "Kentik",
      "url": "https://www.kentik.com"
    },
    "keywords": [
      "datasource",
      "kentik",
      "network",
      "flow",
      "SNMP",
      "NMS",
      "observability",
      "traffic"
    ],
    "logos": {
      "small": "img/logo_small.png",
      "large": "img/logo_large.png"
    },
    "links": [
      {
        "name": "Kentik",
        "url": "https://www.kentik.com"
      },
      {
        "name": "Documentation",
        "url": "https://kb.kentik.com/docs/apis-overview"
      },
      {
        "name": "sponsor",
        "url": "https://www.kentik.com/get-started/"
      }
    ],
    "screenshots": [
      {
        "name": "Query Editor",
        "path": "img/queryeditor.png"
      },
      {
        "name": "Graph Panel",
        "path": "img/graphedit.png"
      },
      {
        "name": "Datasource Configuration",
        "path": "img/datasourceconfig.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Kentik: Overview",
      "path": "dashboards/kentik-home.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: Top Talkers",
      "path": "dashboards/kentik-top-talkers.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: Traffic Detail",
      "path": "dashboards/kentik-osi-health.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: Sites & Devices",
      "path": "dashboards/kentik-site-overview.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: Global Traffic Map",
      "path": "dashboards/kentik-geo-traffic.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: Geo Flow & Interface Health",
      "path": "dashboards/kentik-topology.json"
    },
    {
      "type": "dashboard",
      "name": "Kentik: NMS Device Health",
      "path": "dashboards/kentik-nms-health.json"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.6.0",
    "plugins": []
  }
}